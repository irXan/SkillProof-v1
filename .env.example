# ---------------------------------------------------------------------------
# SkillProof environment variables
# Copy this file to `.env.local` and fill in real values.
#   cp .env.example .env.local
# Never commit `.env.local` or any file that contains real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (required for accounts / saving to Postgres) -----------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the optional "Save to my account" server action.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (required for AI generation) ------------------------------
# Any OpenAI-compatible chat completions API.
# Example (OpenAI):      AI_BASE_URL=https://api.openai.com/v1   AI_MODEL=gpt-4o-mini
# Example (Groq):        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# Example (OpenRouter):  AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=openai/gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
